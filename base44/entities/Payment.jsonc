{
  "name": "Payment",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "provider_payment_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "succeeded",
        "failed",
        "refunded",
        "canceled"
      ],
      "default": "pending"
    },
    "created_at": {
      "type": "string"
    },
    "confirmed_at": {
      "type": "string"
    },
    "failure_reason": {
      "type": "string"
    },
    "webhook_event_id": {
      "type": "string"
    },
    "raw_provider_status": {
      "type": "string"
    }
  },
  "required": [
    "order_id",
    "user_id",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}