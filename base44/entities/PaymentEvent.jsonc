{
  "name": "PaymentEvent",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "payment_succeeded",
        "payment_failed",
        "payment_refunded",
        "payment_canceled",
        "subscription_created",
        "subscription_updated",
        "subscription_canceled"
      ]
    },
    "order_id": {
      "type": "string"
    },
    "payment_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "processed",
        "failed",
        "duplicate"
      ],
      "default": "received"
    },
    "processed_at": {
      "type": "string"
    },
    "failure_reason": {
      "type": "string"
    },
    "raw_payload": {
      "type": "string"
    },
    "signature_valid": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "event_id",
    "provider",
    "event_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}