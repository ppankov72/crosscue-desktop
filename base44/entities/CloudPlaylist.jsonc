{
  "name": "CloudPlaylist",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner user ID"
    },
    "sync_id": {
      "type": "string",
      "description": "Unique sync ID for this playlist across devices \u2014 matches local playlist ID"
    },
    "name": {
      "type": "string"
    },
    "track_descriptors": {
      "type": "string",
      "description": "JSON array of track descriptors (metadata only \u2014 BPM, key, camelot, cue points, ratings, source references \u2014 never File objects or Blob URLs)"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "updated_by_device": {
      "type": "string",
      "description": "Device ID that last updated this playlist"
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "synced",
        "pending",
        "conflict"
      ],
      "default": "synced"
    },
    "deleted": {
      "type": "boolean",
      "default": false,
      "description": "Soft delete flag \u2014 synced to other devices so they can remove locally"
    }
  },
  "required": [
    "user_id",
    "sync_id",
    "name"
  ],
  "rls": {
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "create": true,
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}