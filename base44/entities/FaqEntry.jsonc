{
  "name": "FaqEntry",
  "type": "object",
  "properties": {
    "canonical_key": {
      "type": "string",
      "description": "Unique logical FAQ key, shared across language versions"
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "de",
        "es",
        "bg"
      ]
    },
    "category": {
      "type": "string",
      "description": "FAQ category label in this language"
    },
    "question": {
      "type": "string"
    },
    "answer": {
      "type": "string",
      "description": "Rich text answer (sanitized HTML)"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "updated_by": {
      "type": "string"
    }
  },
  "required": [
    "canonical_key",
    "language",
    "question",
    "answer"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}