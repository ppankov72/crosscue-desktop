{
  "name": "Order",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "plan_code": {
      "type": "string"
    },
    "plan_name": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed",
        "canceled",
        "refunded"
      ],
      "default": "pending"
    },
    "payment_id": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "created_at_snapshot": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    },
    "entitlement_id": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "plan_id",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}