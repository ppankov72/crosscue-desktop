{
  "name": "SecurityEvent",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "login",
        "logout",
        "session_revoked",
        "session_revoked_all",
        "device_registered",
        "device_revoked",
        "profile_changed",
        "myfeed_linked",
        "myfeed_unlinked",
        "entitlement_changed",
        "role_changed",
        "security_setting_changed"
      ]
    },
    "description": {
      "type": "string"
    },
    "device_type": {
      "type": "string"
    },
    "os": {
      "type": "string"
    },
    "browser": {
      "type": "string"
    },
    "ip_anonymized": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "event_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}