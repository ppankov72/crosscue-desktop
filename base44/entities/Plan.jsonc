{
  "name": "Plan",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "trial",
        "weekend",
        "premium"
      ]
    },
    "name": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "interval": {
      "type": "string",
      "enum": [
        "one_time",
        "monthly"
      ],
      "default": "one_time"
    },
    "duration_hours": {
      "type": "number"
    },
    "entitlement_type": {
      "type": "string",
      "enum": [
        "trial",
        "weekend",
        "premium"
      ]
    },
    "trial_seconds": {
      "type": "number"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "code",
    "name",
    "price",
    "entitlement_type"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}